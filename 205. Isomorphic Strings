class Solution:
    def isIsomorphic(self, s: str, t: str) -> bool:

        if len(s) != len(t):
            return False

        mapST = {}
        mapTS = {}

        for i in range(len(s)):

            a = s[i]
            b = t[i]

            if a in mapST and mapST[a] != b:
                return False

            if b in mapTS and mapTS[b] != a:
                return False

            mapST[a] = b
            mapTS[b] = a

        return True
